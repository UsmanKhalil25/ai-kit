{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "bunx",
        "@playwright/mcp@latest",
        "--headless",
        "--browser=chromium",
        "--isolated",
        "--image-responses=omit",
        "--viewport-size=1280x2000"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "playwright*": "deny"
  },
  "agent": {
    "browser": {
      "description": "Headless browser operator — navigates and extracts structured content via the Playwright MCP, returning only a compact result",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "playwright*": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "deny"
        }
      }
    }
  }
}
